  "info": {
    "_postman_id": "1913b406-fb2b-403d-b0f4-53a37d29356d",
    "name": "Panorama Panorama API Restapi API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Panorama and PAN-OS XML and REST APIs for centralized network security\nmanagement across Palo Alto Networks firewalls. The XML API uses\nquery-parameter style request types (`type=keygen`, `type=op`,\n`type=config`, etc.), while the REST API uses versioned resource paths\nunder `/restapi/v{version}/`.\n\n\nContact Support:\n Name: Palo Alto Networks",
      "type": "text/plain"
    }
  }
